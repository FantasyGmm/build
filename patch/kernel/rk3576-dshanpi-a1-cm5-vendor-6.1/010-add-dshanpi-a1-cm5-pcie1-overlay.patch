From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DShanPI <support@dshanpi.com>
Date: Wed, 30 Sep 2026 00:00:00 +0000
Subject: [PATCH] arm64: dts: rockchip: add DShanPI A1 CM5 PCIe1 overlay

The CM5 carrier routes the second combo PHY to either the default USB1 host
path or PCIe1. Keep USB1 in the base DT and provide an explicit, opt-in
overlay that disables the complete USB1 path before enabling PCIe1.

---
 arch/arm64/boot/dts/rockchip/overlay/Makefile |  1 +
 .../overlay/dshanpi-a1-cm5-pcie1.dts          | 47 +++++++++++++++++++
 2 files changed, 48 insertions(+)
 create mode 100644 arch/arm64/boot/dts/rockchip/overlay/dshanpi-a1-cm5-pcie1.dts

diff --git a/arch/arm64/boot/dts/rockchip/overlay/Makefile b/arch/arm64/boot/dts/rockchip/overlay/Makefile
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/rockchip/overlay/Makefile
+++ b/arch/arm64/boot/dts/rockchip/overlay/Makefile
@@ -288,2 +288,4 @@ targets += $(dtbo-y) $(dtbotxt-y)
 always-y		:= $(dtbo-y) $(dtbotxt-y)
+dtbo-$(CONFIG_ARCH_ROCKCHIP) += dshanpi-a1-cm5-pcie1.dtbo
+always-y		+= dshanpi-a1-cm5-pcie1.dtbo
 clean-files		:= *.dtbo
diff --git a/arch/arm64/boot/dts/rockchip/overlay/dshanpi-a1-cm5-pcie1.dts b/arch/arm64/boot/dts/rockchip/overlay/dshanpi-a1-cm5-pcie1.dts
new file mode 100644
index 000000000000..333333333333
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/overlay/dshanpi-a1-cm5-pcie1.dts
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * DShanPI A1 CM5 carrier: switch the shared USB1/PCIe1 path to PCIe1.
+ * The base device tree deliberately keeps the validated USB1 host default.
+ */
+
+/dts-v1/;
+/plugin/;
+
+/ {
+	compatible = "dshanpi,dshanpi-a1-cm5", "rockchip,rk3576";
+
+	fragment@0 {
+		target = <&usb_drd1_dwc3>;
+		__overlay__ {
+			status = "disabled";
+		};
+	};
+
+	fragment@1 {
+		target = <&u2phy1_otg>;
+		__overlay__ {
+			status = "disabled";
+		};
+	};
+
+	fragment@2 {
+		target = <&u2phy1>;
+		__overlay__ {
+			status = "disabled";
+		};
+	};
+
+	fragment@3 {
+		target = <&combphy1_psu>;
+		__overlay__ {
+			status = "okay";
+		};
+	};
+
+	fragment@4 {
+		target = <&pcie1>;
+		__overlay__ {
+			status = "okay";
+		};
+	};
+};
